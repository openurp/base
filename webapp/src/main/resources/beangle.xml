<?xml version="1.0"?>
<beangle xmlns="http://beangle.github.io/schema/framework"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://beangle.github.io/schema/framework http://beangle.github.io/schema/framework-1.0.xsd">
  <ems app-name="base-webapp"/>

  <cdi>
    <module class="org.openurp.base.web.action.admin.edu.DefaultModule"/>
    <module class="org.openurp.base.web.action.admin.hr.DefaultModule"/>
    <module class="org.openurp.base.web.action.admin.std.DefaultModule"/>
    <module class="org.openurp.base.web.action.admin.resource.DefaultModule"/>
    <module class="org.openurp.base.web.action.admin.person.DefaultModule"/>
    <module class="org.openurp.base.web.action.admin.DefaultModule"/>

    <module class="org.openurp.base.web.action.info.DefaultModule"/>

    <module class="org.openurp.base.ws.DefaultModule"/>
    <module class="org.openurp.base.ws.admin.DefaultModule"/>
    <module class="org.openurp.base.ws.edu.DefaultModule"/>
    <module class="org.openurp.base.ws.hr.DefaultModule"/>
    <module class="org.openurp.base.ws.std.DefaultModule"/>
    <module class="org.openurp.base.ws.resource.DefaultModule"/>
    <module class="org.openurp.base.ws.context.DefaultModule"/>
    <module class="org.openurp.base.ws.SchedulerModule"/>

    <module class="org.openurp.starter.web.ProjectModule"/>
  </cdi>

  <mvc>
    <!-- 应用部署在 / 。页面原先的上下文是 /base，这里把 url path 设成 /base，对外地址不变。 -->
    <profile package="org.openurp.base.web.action">
      <url path="/base" suffix=""  style="seo" />
      <interceptor name="web.Interceptor.hibernate"/>
      <interceptor name="web.Interceptor.security"/>
    </profile>

    <!-- 接口原先的上下文是 /api/base。 -->
    <!-- 管理端给前端消费的 JSON。类放在 org.openurp.base.ws.admin，对外是 /api/base/admin。页面仍走上面的 /base。 -->
    <profile package="org.openurp.base.ws.admin">
      <action suffix="WS" defaultMethod="index"/>
      <url path="/api/base/admin" suffix="" style="plur-seo"/>
      <interceptor name="web.Interceptor.hibernate"/>
      <interceptor name="web.Interceptor.cors"/>
      <interceptor name="web.Interceptor.security"/>
    </profile>

    <profile package="org.openurp.base.ws">
      <action suffix="WS" defaultMethod="index"/>
      <url path="/api/base" suffix="" style="plur-seo"/>
      <interceptor name="web.Interceptor.hibernate"/>
      <interceptor name="web.Interceptor.cors"/>
      <interceptor name="web.Interceptor.security"/>
    </profile>

    <profile package="org.openurp.base.ws.edu">
      <action suffix="WS" defaultMethod="index"/>
      <url path="/api/base/edu/{projectId}" suffix="" style="plur-seo"/>
      <interceptor name="web.Interceptor.hibernate"/>
      <interceptor name="web.Interceptor.cors"/>
      <interceptor name="web.Interceptor.security"/>
    </profile>

    <profile package="org.openurp.base.ws.std">
      <action suffix="WS" defaultMethod="index"/>
      <url path="/api/base/std/{projectId}" suffix="" style="plur-seo"/>
      <interceptor name="web.Interceptor.hibernate"/>
      <interceptor name="web.Interceptor.cors"/>
      <interceptor name="web.Interceptor.security"/>
    </profile>
  </mvc>

</beangle>
