{
  "name": "@openurp/base-web",
  "version": "0.4.94",
  "license": "LGPL-3.0-or-later",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.node.json"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "package": "pnpm run build && node ../../scripts/zip-dist.mjs release/base-web.zip",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "pnpm run test:unit"
  },
  "dependencies": {
    "@beangle/bui-vue": "0.0.4-dev.20261001181653",
    "@openurp/sdk-vue": "0.0.3-dev.20261001185731",
    "tdesign-icons-vue-next": "^0.4.4",
    "tdesign-vue-next": "^1.20.1",
    "vue": "^3.5.24",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.2.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  }
